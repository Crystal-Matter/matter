require "./cluster"
require "./identify"
require "tlv"

module Matter
  module Cluster
    # Groups Cluster Implementation (0x0004)
    # Manages group membership for multicast communication
    #
    # Features:
    # - GroupNames (GN): Store names for groups
    #
    # Specification: Matter 1.4 § 1.3
    class Groups < Base
      cluster 0x0004, revision: 4, persist_state: true

      feature :group_names, bit: 0 # GN - Store names for groups

      @[Flags]
      enum NameSupport : UInt8
        GroupNames = 0x80
      end

      # Group 0 is reserved and names are bounded in UTF-8 bytes (Matter 1.4 §1.3.7.1).
      GROUP_ID_MIN          = 1_u16
      GROUP_NAME_MAX_LENGTH =    16
      DEFAULT_MAX_GROUPS    = 16_u8

      alias StatusCode = InteractionModel::StatusCode

      # Input to the Groups addGroup command
      struct AddGroupRequest
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property group_id : DataType::GroupId

        @[TLV::Field(tag: 1)]
        property group_name : String

        def initialize(@group_id : DataType::GroupId, @group_name : String)
        end
      end

      # The AddGroupResponse is sent by the Groups cluster server in response to an AddGroup command.
      struct AddGroupResponse
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property status_code : StatusCode

        @[TLV::Field(tag: 1)]
        property group_id : DataType::GroupId

        def initialize(@status_code : StatusCode, @group_id : DataType::GroupId)
        end
      end

      # Input to the Groups viewGroup command
      struct ViewGroupRequest
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property group_id : DataType::GroupId

        def initialize(@group_id : DataType::GroupId)
        end
      end

      # The ViewGroupResponse command is sent by the Groups cluster server in response to a ViewGroup command.
      struct ViewGroupResponse
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property status_code : StatusCode

        @[TLV::Field(tag: 1)]
        property group_id : DataType::GroupId

        @[TLV::Field(tag: 2)]
        property group_name : String

        def initialize(@status_code : StatusCode, @group_id : DataType::GroupId, @group_name : String)
        end
      end

      # Input to the Groups getGroupMembership command
      struct GetGroupMembershipRequest
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property group_list : Array(DataType::GroupId)

        def initialize(@group_list : Array(DataType::GroupId))
        end
      end

      # The GetGroupMembershipResponse command is sent by the Groups cluster server in response to a GetGroupMembership
      # command.
      #
      # The fields of the GetGroupMembershipResponse command have the following semantics:
      #
      # The Capacity field shall contain the remaining capacity of the Group Table of the node. The following values
      # apply:
      #
      #   • 0 - No further groups may be added.
      #
      #   • 0 < Capacity < 0xfe - Capacity holds the number of groups that may be added.
      #
      #   • 0xfe - At least 1 further group may be added (exact number is unknown).
      #
      #   • null - It is unknown if any further groups may be added.
      #
      # The GroupList field shall contain either the group IDs of all the groups in the Group Table for which the server
      # endpoint is a member of the group (in the case where the GroupList field of the received GetGroupMembership
      # command was empty), or the group IDs of all the groups in the Group Table for which the server endpoint is a
      # member of the group and for which the group ID was included in the the GroupList field of the received
      # GetGroupMembership command (in the case where the GroupList field of the received GetGroupMembership command was
      # not empty).
      #
      # Zigbee: If the total number of groups will cause the maximum payload length of a frame to be exceeded, then the
      # GroupList field shall contain only as many groups as will fit.
      struct GetGroupMembershipResponse
        include TLV::Serializable

        @[TLV::Field(tag: 0, optional: false)]
        property capacity : UInt8?

        @[TLV::Field(tag: 1)]
        property group_list : Array(DataType::GroupId)

        def initialize(@capacity : UInt8?, @group_list : Array(DataType::GroupId))
        end
      end

      # Input to the Groups removeGroup command
      struct RemoveGroupRequest
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property group_id : DataType::GroupId

        def initialize(@group_id : DataType::GroupId)
        end
      end

      # The RemoveGroupResponse command is generated by the server in response to the receipt of a RemoveGroup command.
      struct RemoveGroupResponse
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property status_code : StatusCode

        @[TLV::Field(tag: 1)]
        property group_id : DataType::GroupId

        def initialize(@status_code : StatusCode, @group_id : DataType::GroupId)
        end
      end

      struct RemoveAllGroupsRequest
        include TLV::Serializable

        def initialize
        end
      end

      # Input to the Groups addGroupIfIdentifying command
      struct AddGroupIfIdentifyingRequest
        include TLV::Serializable

        @[TLV::Field(tag: 0)]
        property group_id : DataType::GroupId

        @[TLV::Field(tag: 1)]
        property group_name : String

        def initialize(@group_id : DataType::GroupId, @group_name : String)
        end
      end

      attribute 0x0000, :name_support, NameSupport, default: NameSupport::None

      command 0x00, :add_group, request: AddGroupRequest, response: AddGroupResponse, access: :manage
      command 0x01, :view_group, request: ViewGroupRequest, response: ViewGroupResponse
      command 0x02, :get_group_membership, request: GetGroupMembershipRequest, response: GetGroupMembershipResponse
      command 0x03, :remove_group, request: RemoveGroupRequest, response: RemoveGroupResponse, access: :manage
      command 0x04, :remove_all_groups, access: :manage
      command 0x05, :add_group_if_identifying, request: AddGroupIfIdentifyingRequest, access: :manage

      # Group storage: GroupId => GroupName
      property groups : Hash(UInt16, String)
      @fabric_groups : Hash(UInt8, Hash(UInt16, String))
      @legacy_unscoped_state : Bool = false
      property on_group_added : Proc(UInt16, UInt16, String, UInt8, Nil)?
      property on_group_removed : Proc(UInt16, UInt16, UInt8, Nil)?
      @identify : Identify?

      def initialize(
        endpoint_id : DataType::EndpointNumber,
        @feature_map : Feature = Feature::GroupNames,
        @max_groups : UInt8 = DEFAULT_MAX_GROUPS,
      )
        super(endpoint_id, DataType::ClusterId.new(CLUSTER_ID))
        @groups = Hash(UInt16, String).new
        @fabric_groups = Hash(UInt8, Hash(UInt16, String)).new
        @name_support = @feature_map.group_names? ? NameSupport::GroupNames : NameSupport::None
      end

      # Endpoint binds the co-located Identify server regardless of cluster
      # insertion order. Without one, this endpoint cannot be identifying.
      def bind_identify(identify : Identify?) : Nil
        @identify = identify
      end

      # ------------------------------------------------------------------------
      # Commands
      # ------------------------------------------------------------------------

      def add_group(request : AddGroupRequest) : AddGroupResponse
        status = store_group(request.group_id.id, request.group_name)
        AddGroupResponse.new(status, request.group_id)
      end

      def view_group(request : ViewGroupRequest) : ViewGroupResponse
        group_id = request.group_id.id
        group_name = current_groups[group_id]?
        status = if !valid_group_id?(group_id)
                   InteractionModel::StatusCode::ConstraintError
                 elsif group_name
                   InteractionModel::StatusCode::Success
                 else
                   InteractionModel::StatusCode::NotFound
                 end
        ViewGroupResponse.new(status, request.group_id, group_name || "")
      end

      def get_group_membership(request : GetGroupMembershipRequest) : GetGroupMembershipResponse
        requested = request.group_list.map(&.id)
        members = current_groups.keys.select { |id| requested.empty? || requested.includes?(id) }.map { |id| DataType::GroupId.new(id) }
        capacity = (@max_groups - current_groups.size).to_u8
        GetGroupMembershipResponse.new(capacity, members)
      end

      def remove_group(request : RemoveGroupRequest) : RemoveGroupResponse
        status = delete_group(request.group_id.id)
        RemoveGroupResponse.new(status, request.group_id)
      end

      def remove_all_groups : InteractionModel::Status
        groups = current_groups
        if fabric_index = request_fabric_index
          groups.each_key do |group_id|
            @on_group_removed.try(&.call(group_id, endpoint_id.number, fabric_index))
          end
        end
        groups.clear
        increment_version
        InteractionModel::Status.success
      end

      # No response struct is defined for this command, so the outcome is the command status.
      def add_group_if_identifying(request : AddGroupIfIdentifyingRequest) : InteractionModel::Status
        return InteractionModel::Status.success unless @identify.try(&.identifying?)

        InteractionModel::Status.new(store_group(request.group_id.id, request.group_name))
      end

      private def valid_group_id?(group_id : UInt16) : Bool
        group_id >= GROUP_ID_MIN
      end

      private def store_group(group_id : UInt16, group_name : String) : InteractionModel::StatusCode
        unless valid_group_id?(group_id) && group_name.bytesize <= GROUP_NAME_MAX_LENGTH
          return InteractionModel::StatusCode::ConstraintError
        end
        groups = current_groups
        if groups.size >= @max_groups && !groups.has_key?(group_id)
          return InteractionModel::StatusCode::ResourceExhausted
        end

        if fabric_index = request_fabric_index
          @on_group_added.try(&.call(group_id, endpoint_id.number, group_name, fabric_index))
        end

        groups[group_id] = group_name
        increment_version
        InteractionModel::StatusCode::Success
      end

      private def delete_group(group_id : UInt16) : InteractionModel::StatusCode
        return InteractionModel::StatusCode::ConstraintError unless valid_group_id?(group_id)
        if current_groups.delete(group_id)
          if fabric_index = request_fabric_index
            @on_group_removed.try(&.call(group_id, endpoint_id.number, fabric_index))
          end
          increment_version
          InteractionModel::StatusCode::Success
        else
          InteractionModel::StatusCode::NotFound
        end
      end

      # ------------------------------------------------------------------------
      # Persistence support
      # ------------------------------------------------------------------------

      private struct PersistedState
        include Storage::Record

        getter groups : Hash(UInt16, String)
        getter fabric_groups : Hash(UInt8, Hash(UInt16, String)) = Hash(UInt8, Hash(UInt16, String)).new
        getter data_version : UInt32

        def initialize(
          @groups : Hash(UInt16, String),
          @data_version : UInt32,
          @fabric_groups : Hash(UInt8, Hash(UInt16, String)) = Hash(UInt8, Hash(UInt16, String)).new,
        )
        end
      end

      def save_state : Storage::Document?
        PersistedState.new(@groups, @data_version, @fabric_groups).to_document
      end

      def restore_state(document : Storage::Document) : Nil
        state = PersistedState.from_document(document)
        @groups = state.groups
        @fabric_groups = state.fabric_groups
        @legacy_unscoped_state = !document.has_key?("fabric_groups")
        @data_version = state.data_version
      rescue ex
        Log.warn(exception: ex) { "Groups restore_state failed; starting fresh" }
      end

      # Public API
      def member_of?(group_id : UInt16) : Bool
        current_groups.has_key?(group_id)
      end

      def group_count : Int32
        current_groups.size
      end

      # Indexes with stored group names, including any orphaned after a crash.
      def fabric_indices : Array(UInt8)
        @fabric_groups.keys
      end

      # Used to rebuild the operational group table after all cluster state
      # has restored. The copy cannot mutate this cluster's fabric state.
      def group_names_for_fabric(fabric_index : UInt8) : Hash(UInt16, String)
        (@fabric_groups[fabric_index]? || Hash(UInt16, String).new).dup
      end

      # Old documents stored all Groups memberships without a fabric index.
      # Import only a membership that the old GroupTable explicitly tied to
      # this endpoint and fabric. A current document always has fabric_groups,
      # so an intentionally removed membership cannot reappear on restart.
      def migrate_unscoped_group(group_id : UInt16, fabric_index : UInt8) : Bool
        return false unless @legacy_unscoped_state
        return false unless name = @groups[group_id]?
        fabric_groups = @fabric_groups[fabric_index] ||= Hash(UInt16, String).new
        return false if fabric_groups.has_key?(group_id)

        fabric_groups[group_id] = name
        increment_version
        true
      end

      # Fabric indexes can be reused after RemoveFabric. Discard the removed
      # fabric's group names before another commissioner receives that index.
      def remove_fabric(fabric_index : UInt8) : Nil
        return unless @fabric_groups.delete(fabric_index)

        increment_version
      end

      private def current_groups : Hash(UInt16, String)
        if fabric_index = request_fabric_index
          @fabric_groups[fabric_index] ||= Hash(UInt16, String).new
        else
          @groups
        end
      end
    end
  end
end
