require "./cluster"
require "tlv"
require "log"
require "../datatype/node_id"
require "../datatype/case_authenticated_tag"

module Matter
  module Cluster
    # Access Control Cluster (0x001F)
    #
    # Provides fine-grained access control for Matter devices using
    # Access Control Lists (ACLs).
    #
    # Matter Spec: Core 9.10
    class AccessControl < Base
      Log = ::Log.for("matter.cluster.access_control")

      cluster 0x001F, revision: 3, persist_state: false

      feature :extension, bit: 0 # EXTS - Extension attribute and its change event
      feature :auxiliary, bit: 2 # AUX - generated, read-only ACL entries

      # ManagedDevice is not advertised yet. Hosts can install a transient ARL
      # for read enforcement; write, invoke, event and review flows still need
      # implementation before the complete feature may be enabled.
      GLOBAL_ATTRIBUTE_ID_START               = 0xFFF8_u32
      GLOBAL_ATTRIBUTE_ID_END                 = 0xFFFD_u32
      ARL_ROOT_ENDPOINT_ID                    =      0_u16
      ARL_WIFI_NETWORK_MANAGEMENT_CLUSTER_ID  = 0x0451_u32
      ARL_THREAD_BORDER_ROUTER_CLUSTER_ID     = 0x0452_u32
      ARL_THREAD_NETWORK_DIRECTORY_CLUSTER_ID = 0x0453_u32

      # Minimum table limits the specification requires (Matter Core §9.10.5)
      DEFAULT_SUBJECTS_PER_ENTRY = 4_u16
      DEFAULT_TARGETS_PER_ENTRY  = 3_u16
      DEFAULT_ENTRIES_PER_FABRIC = 4_u16

      # Access Control Entry Privilege Levels
      enum AccessControlEntryPrivilege : UInt8
        View       = 1 # Can read attributes
        ProxyView  = 2 # Can read and observe
        Operate    = 3 # Can read and invoke commands
        Manage     = 4 # Can read, write, and invoke commands
        Administer = 5 # Full control including ACL management
      end

      # Access Control Entry Auth Mode
      enum AccessControlEntryAuthMode : UInt8
        PASE  = 1 # PASE authentication (commissioning)
        CASE  = 2 # CASE authentication (operational)
        Group = 3 # Group authentication
      end

      # Matter 1.6 tag 5 on AccessControlEntryStruct. Auxiliary entries are
      # generated by the provisional AUX feature, which this server does not
      # advertise. Decode the field so a primary ACL write cannot ignore it.
      enum AccessControlAuxiliaryType : UInt8
        System    = 0
        Groupcast = 1
      end

      enum ChangeType : UInt8
        Changed = 0
        Added   = 1
        Removed = 2
      end

      enum AccessRestrictionType : UInt8
        AttributeAccessForbidden = 0
        AttributeWriteForbidden  = 1
        CommandForbidden         = 2
        EventForbidden           = 3
      end

      struct AccessRestriction
        getter type : AccessRestrictionType
        getter id : UInt32?

        def initialize(@type : AccessRestrictionType, @id : UInt32?)
        end
      end

      struct AccessRestrictionEntry
        getter endpoint : UInt16
        getter cluster : UInt32
        getter restrictions : Array(AccessRestriction)

        def initialize(@endpoint : UInt16, @cluster : UInt32, @restrictions : Array(AccessRestriction))
        end
      end

      struct Target
        include TLV::Serializable

        @[TLV::Field(tag: 0, optional: false)]
        property cluster : UInt32?

        @[TLV::Field(tag: 1, optional: false)]
        property endpoint : UInt16?

        @[TLV::Field(tag: 2, optional: false)]
        property device_type : UInt32?

        def initialize(@cluster : UInt32? = nil, @endpoint : UInt16? = nil, @device_type : UInt32? = nil)
        end
      end

      # Access Control Entry
      struct AccessControlEntry
        include TLV::Serializable

        @[TLV::Field(tag: 1)]
        property privilege : AccessControlEntryPrivilege

        @[TLV::Field(tag: 2)]
        property auth_mode : AccessControlEntryAuthMode

        @[TLV::Field(tag: 3, optional: false)]
        property subjects : Array(UInt64)? # Null means all subjects

        @[TLV::Field(tag: 4, optional: false)]
        property targets : Array(Target)? # nil means all targets

        @[TLV::Field(tag: 5, optional: true)]
        property auxiliary_type : AccessControlAuxiliaryType?

        # fabric_index is optional during deserialization (client doesn't send it),
        # but required when stored (server fills it in)
        @[TLV::Field(tag: 254, optional: true)]
        property fabric_index : UInt8?

        def initialize(@privilege : AccessControlEntryPrivilege,
                       @auth_mode : AccessControlEntryAuthMode,
                       @subjects : Array(UInt64)?,
                       @targets : Array(Target)?,
                       @fabric_index : UInt8? = nil,
                       @auxiliary_type : AccessControlAuxiliaryType? = nil)
        end
      end

      # Extension Entry (for future use)
      struct ExtensionEntry
        include TLV::Serializable

        @[TLV::Field(tag: 1)]
        property data : Bytes

        @[TLV::Field(tag: 254, optional: true)]
        property fabric_index : UInt8?

        def initialize(@data : Bytes, @fabric_index : UInt8? = nil)
        end
      end

      struct EntryChangedEvent
        include TLV::Serializable

        @[TLV::Field(tag: 1, optional: false)]
        property admin_node_id : UInt64?

        @[TLV::Field(tag: 2, optional: false)]
        property admin_passcode_id : UInt16?

        @[TLV::Field(tag: 3)]
        property change_type : ChangeType

        @[TLV::Field(tag: 4, optional: false)]
        property latest_value : AccessControlEntry?

        def initialize(@admin_node_id : UInt64?, @admin_passcode_id : UInt16?,
                       @change_type : ChangeType, @latest_value : AccessControlEntry?)
        end
      end

      struct ExtensionChangedEvent
        include TLV::Serializable

        @[TLV::Field(tag: 1, optional: false)]
        property admin_node_id : UInt64?

        @[TLV::Field(tag: 2, optional: false)]
        property admin_passcode_id : UInt16?

        @[TLV::Field(tag: 3)]
        property change_type : ChangeType

        @[TLV::Field(tag: 4, optional: false)]
        property latest_value : ExtensionEntry?

        def initialize(@admin_node_id : UInt64?, @admin_passcode_id : UInt16?,
                       @change_type : ChangeType, @latest_value : ExtensionEntry?)
        end
      end

      struct AuxiliaryAccessUpdatedEvent
        include TLV::Serializable

        @[TLV::Field(tag: 0, optional: false)]
        property admin_node_id : UInt64?

        def initialize(@admin_node_id : UInt64?)
        end
      end

      # ACL and Extension are fabric-scoped lists: reads are filtered to the
      # accessing fabric and writes replace only that fabric's entries (see
      # `acl`, `acl=`, `extension` and `extension=`). They are persisted by
      # the hand-written records further down.
      attribute 0x0000, :acl, Array(AccessControlEntry), computed: true, writable: true, read_access: :administer, write_access: :administer, fabric_scoped: true
      attribute 0x0001, :extension, Array(ExtensionEntry), computed: true, writable: true, read_access: :administer, write_access: :administer, fabric_scoped: true, requires: :extension
      attribute 0x0002, :subjects_per_access_control_entry, UInt16, default: DEFAULT_SUBJECTS_PER_ENTRY, fixed: true
      attribute 0x0003, :targets_per_access_control_entry, UInt16, default: DEFAULT_TARGETS_PER_ENTRY, fixed: true
      attribute 0x0004, :access_control_entries_per_fabric, UInt16, default: DEFAULT_ENTRIES_PER_FABRIC, fixed: true
      attribute 0x0007, :auxiliary_acl, Array(AccessControlEntry), computed: true,
        read_access: :administer, fabric_scoped: true, omit_changes: true, requires: :auxiliary

      event 0x00, :access_control_entry_changed, priority: :info, access: :administer
      event 0x01, :access_control_extension_changed, priority: :info, access: :administer, requires: :extension
      event 0x03, :auxiliary_access_updated, priority: :info, access: :administer,
        requires: :auxiliary, payload: AuxiliaryAccessUpdatedEvent

      @acl = [] of AccessControlEntry
      @extension = [] of ExtensionEntry
      @auxiliary_acl = [] of AccessControlEntry
      @access_restrictions = {} of UInt8 => Array(AccessRestrictionEntry)
      @acl_before_write = [] of AccessControlEntry
      @extension_before_write = [] of ExtensionEntry

      before_write :acl do |_entries|
        @acl_before_write = acl(@request_fabric_index).dup
        nil
      end

      after_write :acl do
        if fabric_index = @request_fabric_index
          emit_acl_changes(@acl_before_write, acl(fabric_index), fabric_index)
        end
      end

      before_write :extension do |_entries|
        @extension_before_write = extension(@request_fabric_index).dup
        nil
      end

      after_write :extension do
        if fabric_index = @request_fabric_index
          emit_extension_changes(@extension_before_write, extension(fabric_index), fabric_index)
        end
      end

      def initialize(endpoint_id : DataType::EndpointNumber, @feature_map : Feature = Feature::Extension)
        super(endpoint_id, DataType::ClusterId.new(CLUSTER_ID))
      end

      # The fabric-scoped lists are filtered to the accessing fabric; a read
      # outside a fabric (PASE) sees every entry.
      def acl(fabric_index : UInt8? = nil) : Array(AccessControlEntry)
        fabric_index ? get_acl_for_fabric(fabric_index) : @acl
      end

      def extension(fabric_index : UInt8? = nil) : Array(ExtensionEntry)
        fabric_index ? @extension.select { |entry| entry.fabric_index == fabric_index } : @extension
      end

      def auxiliary_acl(fabric_index : UInt8? = nil) : Array(AccessControlEntry)
        return [] of AccessControlEntry unless fabric_index
        @auxiliary_acl.select { |entry| entry.fabric_index == fabric_index }
      end

      # A host-owned policy replaces one fabric's transient ARL. Empty entries
      # remove that fabric's restrictions. This is not an advertised MNGD wire
      # attribute and hosts must reinstall it after restart.
      def configure_access_restrictions(fabric_index : UInt8, entries : Array(AccessRestrictionEntry)) : Nil
        if fabric_index == 0 || entries.any? { |entry| entry.restrictions.empty? || !restriction_target_allowed?(entry.endpoint, entry.cluster) }
          raise Matter::ConfigurationError.new("Invalid access restriction configuration")
        end
        if entries.empty?
          @access_restrictions.delete(fabric_index)
        else
          @access_restrictions[fabric_index] = entries.map do |entry|
            AccessRestrictionEntry.new(entry.endpoint, entry.cluster, entry.restrictions.dup)
          end
        end
      end

      def attribute_read_restricted?(fabric_index : UInt8, endpoint : UInt16,
                                     cluster : UInt32, attribute : UInt32) : Bool
        return false unless restriction_target_allowed?(endpoint, cluster)
        return false if GLOBAL_ATTRIBUTE_ID_START <= attribute <= GLOBAL_ATTRIBUTE_ID_END
        restricted_by?(fabric_index, endpoint, cluster, attribute) do |restriction|
          restriction.type.attribute_access_forbidden?
        end
      end

      def attribute_write_restricted?(fabric_index : UInt8, endpoint : UInt16,
                                      cluster : UInt32, attribute : UInt32) : Bool
        return false if GLOBAL_ATTRIBUTE_ID_START <= attribute <= GLOBAL_ATTRIBUTE_ID_END
        restricted_by?(fabric_index, endpoint, cluster, attribute) do |restriction|
          restriction.type.attribute_access_forbidden? || restriction.type.attribute_write_forbidden?
        end
      end

      def command_restricted?(fabric_index : UInt8, endpoint : UInt16,
                              cluster : UInt32, command : UInt32) : Bool
        restricted_by?(fabric_index, endpoint, cluster, command) do |restriction|
          restriction.type.command_forbidden?
        end
      end

      def event_restricted?(fabric_index : UInt8, endpoint : UInt16,
                            cluster : UInt32, event : UInt32) : Bool
        restricted_by?(fabric_index, endpoint, cluster, event) do |restriction|
          restriction.type.event_forbidden?
        end
      end

      private def restricted_by?(fabric_index : UInt8, endpoint : UInt16,
                                 cluster : UInt32, id : UInt32, & : AccessRestriction -> Bool) : Bool
        (@access_restrictions[fabric_index]? || [] of AccessRestrictionEntry).any? do |entry|
          entry.endpoint == endpoint && entry.cluster == cluster && entry.restrictions.any? do |restriction|
            yield(restriction) && (restriction.id.nil? || restriction.id == id)
          end
        end
      end

      # Matter 1.6's standard ARL exception checker permits only network
      # infrastructure management clusters outside the root endpoint.
      private def restriction_target_allowed?(endpoint : UInt16, cluster : UInt32) : Bool
        endpoint != ARL_ROOT_ENDPOINT_ID && cluster.in?(
          ARL_WIFI_NETWORK_MANAGEMENT_CLUSTER_ID,
          ARL_THREAD_BORDER_ROUTER_CLUSTER_ID,
          ARL_THREAD_NETWORK_DIRECTORY_CLUSTER_ID)
      end

      # A Groupcast listener's auxiliary ACL is derived from Membership. Keep
      # it out of the writable primary ACL and publish the exact effective
      # entries used by group message authorization.
      def set_groupcast_auxiliary_acl(entries : Array(AccessControlEntry),
                                      admin_node_id : UInt64? = nil,
                                      emit_change : Bool = true) : Nil
        unless @feature_map.auxiliary?
          raise Matter::ConfigurationError.new("Groupcast auxiliary ACL requires Access Control AUX")
        end
        unless entries.all? do |entry|
                 entry.auxiliary_type == AccessControlAuxiliaryType::Groupcast &&
                 entry.auth_mode == AccessControlEntryAuthMode::Group &&
                 entry.fabric_index && (entry.targets.try(&.size) || 0) <= targets_per_access_control_entry
               end
          raise Matter::ConfigurationError.new("Invalid Groupcast auxiliary ACL entry")
        end
        previous = @auxiliary_acl.select { |entry| entry.auxiliary_type == AccessControlAuxiliaryType::Groupcast }
        return if previous == entries
        @auxiliary_acl.reject! { |entry| entry.auxiliary_type == AccessControlAuxiliaryType::Groupcast }
        @auxiliary_acl.concat(entries)
        increment_version_and_notify(ATTR_AUXILIARY_ACL)
        if emit_change
          fabric_indexes = (previous.map(&.fabric_index) + entries.map(&.fabric_index)).compact
          fabric_indexes.uniq!.each do |fabric_index|
            emit_event(EVENT_AUXILIARY_ACCESS_UPDATED, AuxiliaryAccessUpdatedEvent.new(admin_node_id), fabric_index)
          end
        end
      end

      struct PersistedTarget
        include Storage::Record

        getter cluster : UInt32?
        getter endpoint : UInt16?
        getter device_type : UInt32?

        def initialize(@cluster : UInt32?, @endpoint : UInt16?, @device_type : UInt32?)
        end
      end

      struct PersistedAclEntry
        include Storage::Record

        getter privilege : AccessControlEntryPrivilege
        getter auth_mode : AccessControlEntryAuthMode
        getter subjects : Array(UInt64)?
        getter targets : Array(PersistedTarget)?
        getter fabric_index : UInt8?

        def initialize(
          @privilege : AccessControlEntryPrivilege,
          @auth_mode : AccessControlEntryAuthMode,
          @subjects : Array(UInt64)?,
          @targets : Array(PersistedTarget)?,
          @fabric_index : UInt8?,
        )
        end
      end

      struct PersistedExtensionEntry
        include Storage::Record

        getter data : Bytes
        getter fabric_index : UInt8

        def initialize(@data : Bytes, @fabric_index : UInt8)
        end
      end

      struct PersistedState
        include Storage::Record

        getter data_version : UInt32
        getter acl : Array(PersistedAclEntry)
        getter extension : Array(PersistedExtensionEntry)

        def initialize(
          @data_version : UInt32,
          @acl : Array(PersistedAclEntry),
          @extension : Array(PersistedExtensionEntry),
        )
        end
      end

      def save_state : Storage::Document?
        PersistedState.new(
          data_version: @data_version,
          acl: @acl.map do |entry|
            PersistedAclEntry.new(
              privilege: entry.privilege,
              auth_mode: entry.auth_mode,
              subjects: entry.subjects,
              targets: entry.targets.try do |targets|
                targets.map { |target| PersistedTarget.new(target.cluster, target.endpoint, target.device_type) }
              end,
              fabric_index: entry.fabric_index
            )
          end,
          extension: @extension.compact_map do |entry|
            entry.fabric_index.try { |index| PersistedExtensionEntry.new(entry.data, index) }
          end
        ).to_document
      end

      def restore_state(document : Storage::Document) : Nil
        state = PersistedState.from_document(document)
        @data_version = state.data_version

        @acl = state.acl.compact_map do |entry|
          idx = entry.fabric_index
          unless idx
            Log.warn { "restore_state: skipping ACL entry without fabric_index" }
            next
          end

          targets = entry.targets.try do |tgts|
            tgts.map { |target| Target.new(cluster: target.cluster, endpoint: target.endpoint, device_type: target.device_type) }
          end

          AccessControlEntry.new(
            privilege: entry.privilege,
            auth_mode: entry.auth_mode,
            subjects: entry.subjects,
            targets: targets,
            fabric_index: idx
          )
        end

        @extension = state.extension.map { |entry| ExtensionEntry.new(entry.data, entry.fabric_index) }
      rescue ex
        Log.error(exception: ex) { "AccessControl restore_state failed; starting fresh" }
      end

      # Check if a subject has the required privilege
      # Supports CaseAuthenticatedTag (CAT) subject matching per Matter spec
      def check_access(subject : UInt64, fabric_index : UInt8, privilege : AccessControlEntryPrivilege,
                       cluster : UInt32? = nil, endpoint : UInt16? = nil, device_type : UInt32? = nil,
                       auth_mode : AccessControlEntryAuthMode = AccessControlEntryAuthMode::CASE) : Bool
        # Find matching ACL entries for this fabric
        matching_entries = (@acl + @auxiliary_acl).select do |entry|
          subjects = entry.subjects
          entry.fabric_index == fabric_index &&
            entry.auth_mode == auth_mode &&
            (!subjects || subjects.empty? || subjects.any? { |acl_subject| subject_matches?(acl_subject, subject) })
        end

        # Check if any entry grants sufficient privilege
        matching_entries.any? do |entry|
          # Check privilege level (higher privilege includes lower)
          has_privilege = entry.privilege >= privilege

          # Check target matching
          has_target_access = if targets = entry.targets
                                # Per spec, an empty targets list is a wildcard (all targets).
                                targets.empty? || targets.any? do |target|
                                  (!target.cluster || target.cluster == cluster) &&
                                    (!target.endpoint || target.endpoint == endpoint) &&
                                    (!target.device_type || target.device_type == device_type)
                                end
                              else
                                true # nil targets means all targets
                              end

          has_privilege && has_target_access
        end
      end

      # Convenience wrapper for the generated cluster metadata privilege enum.
      def check_access(subject : UInt64, fabric_index : UInt8, privilege : InteractionModel::EntryPrivilege,
                       cluster : UInt32? = nil, endpoint : UInt16? = nil, device_type : UInt32? = nil,
                       auth_mode : InteractionModel::EntryAuthMode = InteractionModel::EntryAuthMode::Case) : Bool
        check_access(
          subject: subject,
          fabric_index: fabric_index,
          privilege: AccessControlEntryPrivilege.from_value(privilege.value),
          cluster: cluster,
          endpoint: endpoint,
          device_type: device_type,
          auth_mode: AccessControlEntryAuthMode.from_value(auth_mode.value)
        )
      end

      # Check if a subject (from incoming request) matches an ACL subject
      # Supports CaseAuthenticatedTag (CAT) matching:
      # - For CAT subjects: identity must match, incoming version >= ACL version
      # - For regular NodeIds: exact match required
      private def subject_matches?(acl_subject : UInt64, incoming_subject : UInt64) : Bool
        acl_node = DataType::NodeId.new(acl_subject)
        incoming_node = DataType::NodeId.new(incoming_subject)

        # If both are CAT-encoded, use CAT matching rules
        if acl_node.case_authenticated_tag? && incoming_node.case_authenticated_tag?
          begin
            acl_cat = acl_node.extract_as_case_authenticated_tag
            incoming_cat = incoming_node.extract_as_case_authenticated_tag

            # CAT matching: identity must match, incoming version >= ACL version
            acl_cat.identity_value == incoming_cat.identity_value &&
              incoming_cat.version >= acl_cat.version
          rescue ex
            Log.trace(exception: ex) { "CAT extraction failed; falling back to exact subject match" }
            acl_subject == incoming_subject
          end
        else
          # Regular NodeId: exact match required
          acl_subject == incoming_subject
        end
      end

      # Helper: Get ACL entries for a specific fabric
      def get_acl_for_fabric(fabric_index : UInt8) : Array(AccessControlEntry)
        @acl.select { |entry| entry.fabric_index == fabric_index }
      end

      # Helper: Remove all ACL entries for a fabric
      def remove_fabric_acl(fabric_index : UInt8) : Nil
        @acl.reject! { |entry| entry.fabric_index == fabric_index }
        @auxiliary_acl.reject! { |entry| entry.fabric_index == fabric_index }
        @access_restrictions.delete(fabric_index)
        increment_version_and_notify(ATTR_ACL)
        notify_changed(ATTR_AUXILIARY_ACL) if @feature_map.auxiliary?
      end

      # Replaces the accessing fabric's ACL entries (all entries outside a fabric).
      def acl=(entries : Array(AccessControlEntry)) : Nil
        if entries.any? { |entry| !entry.auxiliary_type.nil? }
          raise Matter::ClusterError.new("Primary ACL entries cannot carry AuxiliaryType", InteractionModel::StatusCode::Failure)
        end
        fabric_index = request_fabric_index
        exceeds_fabric_limit = if fabric_index
                                 entries.size > access_control_entries_per_fabric
                               else
                                 entries.group_by(&.fabric_index).values.any? { |fabric_entries| fabric_entries.size > access_control_entries_per_fabric }
                               end
        if exceeds_fabric_limit || entries.any? do |entry|
             (entry.subjects.try(&.size) || 0) > subjects_per_access_control_entry ||
             (entry.targets.try(&.size) || 0) > targets_per_access_control_entry
           end
          raise Matter::ClusterError.new("ACL entry exceeds the advertised limit", InteractionModel::StatusCode::ConstraintError)
        end
        entries.map! do |entry|
          entry.fabric_index = fabric_index if fabric_index
          entry
        end
        if fabric_index
          @acl.reject! { |entry| entry.fabric_index == fabric_index }
          @acl.concat(entries)
        else
          @acl = entries
        end
        increment_version_and_notify(ATTR_ACL)
      end

      # Replaces the accessing fabric's Extension entries (all entries outside a fabric).
      def extension=(entries : Array(ExtensionEntry)) : Nil
        fabric_index = request_fabric_index
        if entries.any? { |entry| entry.data.size > 128 || !valid_extension_data?(entry.data) }
          raise Matter::ClusterError.new("Invalid Access Control Extension data", InteractionModel::StatusCode::ConstraintError)
        end
        if fabric_index
          if entries.size > 1
            raise Matter::ClusterError.new("Only one Extension entry is allowed per fabric", InteractionModel::StatusCode::ConstraintError)
          end
          entries.map! do |entry|
            entry.fabric_index = fabric_index
            entry
          end
          @extension.reject! { |entry| entry.fabric_index == fabric_index }
          @extension.concat(entries)
        else
          if entries.any? { |entry| entry.fabric_index.nil? } || entries.group_by(&.fabric_index).any? { |_index, items| items.size > 1 }
            raise Matter::ClusterError.new("Extension entry needs one FabricIndex per fabric", InteractionModel::StatusCode::ConstraintError)
          end
          @extension = entries
        end
        increment_version_and_notify(ATTR_EXTENSION)
      end

      private def valid_extension_data?(data : Bytes) : Bool
        io = IO::Memory.new(data)
        value = TLV::Any.from_io(io)
        return false unless io.pos == data.size && value.header.anonymous? && value.header.element_type.list?
        value.as_list.all? do |item|
          type = item.header.tag_type
          type.common_profile? || type.vendor_profile?
        end
      rescue
        false
      end

      # The SDK reports per-entry changes for administrator writes, but does
      # not report internal startup restore or fabric cleanup as admin edits.
      private def emit_acl_changes(previous : Array(AccessControlEntry), current : Array(AccessControlEntry), fabric_index : UInt8) : Nil
        admin_node_id, admin_passcode_id = change_administrator
        return if admin_node_id.nil? && admin_passcode_id.nil?

        {previous.size, current.size}.max.times do |index|
          old_entry = previous[index]?
          new_entry = current[index]?
          next if old_entry && new_entry && old_entry.to_slice == new_entry.to_slice

          change_type = if !old_entry
                          ChangeType::Added
                        elsif !new_entry
                          ChangeType::Removed
                        else
                          ChangeType::Changed
                        end
          emit_event(EVENT_ACCESS_CONTROL_ENTRY_CHANGED,
            EntryChangedEvent.new(admin_node_id, admin_passcode_id, change_type, new_entry), fabric_index)
        end
      end

      private def emit_extension_changes(previous : Array(ExtensionEntry), current : Array(ExtensionEntry), fabric_index : UInt8) : Nil
        admin_node_id, admin_passcode_id = change_administrator
        return if admin_node_id.nil? && admin_passcode_id.nil?

        {previous.size, current.size}.max.times do |index|
          old_entry = previous[index]?
          new_entry = current[index]?
          next if old_entry && new_entry && old_entry.to_slice == new_entry.to_slice

          change_type = if !old_entry
                          ChangeType::Added
                        elsif !new_entry
                          ChangeType::Removed
                        else
                          ChangeType::Changed
                        end
          emit_event(EVENT_ACCESS_CONTROL_EXTENSION_CHANGED,
            ExtensionChangedEvent.new(admin_node_id, admin_passcode_id, change_type, new_entry), fabric_index)
        end
      end

      private def change_administrator : Tuple(UInt64?, UInt16?)
        if request_is_case_session?
          {@request_peer_node_id, nil}
        else
          {nil, nil}
        end
      end
    end
  end
end
