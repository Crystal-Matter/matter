      struct PersistedState
        include Storage::Record

        getter data_version : UInt32
        getter acl : Array(PersistedAclEntry)
        getter extension : Array(PersistedExtensionEntry)
        getter access_restrictions : Array(PersistedRestrictionEntry) = [] of PersistedRestrictionEntry
        getter commissioning_arl : Array(PersistedRestrictionEntry) = [] of PersistedRestrictionEntry
        getter? commissioning_arl_configured : Bool = false
        getter pending_restriction_reviews : Array(PersistedRestrictionReview) = [] of PersistedRestrictionReview
        getter next_restriction_review_token : UInt64 = 0_u64
        getter review_requests_in_progress : Array(UInt64) = [] of UInt64
        getter review_completions_in_progress : Array(UInt64) = [] of UInt64

        def initialize(
          @data_version : UInt32,
          @acl : Array(PersistedAclEntry),
          @extension : Array(PersistedExtensionEntry),
          @access_restrictions : Array(PersistedRestrictionEntry) = [] of PersistedRestrictionEntry,
          @commissioning_arl : Array(PersistedRestrictionEntry) = [] of PersistedRestrictionEntry,
          @commissioning_arl_configured : Bool = false,
          @pending_restriction_reviews : Array(PersistedRestrictionReview) = [] of PersistedRestrictionReview,
          @next_restriction_review_token : UInt64 = 0_u64,
          @review_requests_in_progress : Array(UInt64) = [] of UInt64,
          @review_completions_in_progress : Array(UInt64) = [] of UInt64,
        )
        end
      end

      def save_state : Storage::Document?
        PersistedState.new(
          data_version: @data_version,
          acl: @acl.map do |entry|
            PersistedAclEntry.new(
              privilege: entry.privilege,
              auth_mode: entry.auth_mode,
              subjects: entry.subjects,
              targets: entry.targets.try do |targets|
                targets.map { |target| PersistedTarget.new(target.cluster, target.endpoint, target.device_type) }
              end,
              fabric_index: entry.fabric_index
            )
          end,
          extension: @extension.compact_map do |entry|
            entry.fabric_index.try { |index| PersistedExtensionEntry.new(entry.data, index) }
          end,
          access_restrictions: @access_restrictions.flat_map do |fabric_index, entries|
            entries.map { |entry| persisted_restriction_entry(entry, fabric_index) }
          end,
          commissioning_arl: @commissioning_arl.map do |entry|
            persisted_restriction_entry(
              AccessRestrictionEntry.new(entry.endpoint, entry.cluster, entry.restrictions))
          end,
          commissioning_arl_configured: @commissioning_arl_configured,
          pending_restriction_reviews: @pending_restriction_reviews.values.map do |request|
            PersistedRestrictionReview.new(request.token, request.fabric_index,
              request.entries.map { |entry| persisted_restriction_entry(entry) },
              @pending_restriction_review_deadlines[request.token])
          end,
          next_restriction_review_token: @next_restriction_review_token,
          review_requests_in_progress: @review_requests_in_progress.dup,
          review_completions_in_progress: @review_completions_in_progress.dup
        ).to_document
      end

      private def persisted_restriction_entry(entry : AccessRestrictionEntry,
                                              fabric_index : UInt8? = nil) : PersistedRestrictionEntry
        PersistedRestrictionEntry.new(entry.endpoint, entry.cluster,
          entry.restrictions.map { |restriction| PersistedRestriction.new(restriction.type, restriction.id) },
          fabric_index)
      end

      def restore_state(document : Storage::Document) : Nil
        has_managed_state = MANAGED_PERSISTED_KEYS.any? { |key| document.has_key?(key) }
        if (has_managed_state || @feature_map.managed_device?) &&
           MANAGED_PERSISTED_KEYS.any? { |key| !document.has_key?(key) }
          raise Matter::AccessControlRestoreError.new("Missing managed restriction state fields")
        end
        state = PersistedState.from_document(document)
        unless state.review_requests_in_progress.empty? && state.review_completions_in_progress.empty?
          raise Matter::AccessControlRestoreError.new("Unfinished restriction review operation")
        end
        restrictions = {} of UInt8 => Array(AccessRestrictionEntry)
        state.access_restrictions.each do |stored|
          fabric_index = stored.fabric_index ||
                         raise Matter::StorageError.new("ARL entry has no fabric index")
          entry = restored_restriction_entry(stored)
          if fabric_index == 0 || fabric_index > MAX_VALID_FABRIC_INDEX ||
             invalid_access_restriction_entry?(entry)
            raise Matter::StorageError.new("Invalid persisted ARL entry")
          end
          (restrictions[fabric_index] ||= [] of AccessRestrictionEntry) << entry
        end
        commissioning_arl = state.commissioning_arl.map do |stored|
          entry = restored_restriction_entry(stored)
          if stored.fabric_index || invalid_access_restriction_entry?(entry)
            raise Matter::StorageError.new("Invalid persisted CommissioningARL entry")
          end
          CommissioningAccessRestrictionEntry.new(entry.endpoint, entry.cluster, entry.restrictions)
        end
        pending = {} of UInt64 => RestrictionReviewRequest
        deadlines = {} of UInt64 => Time
        state.pending_restriction_reviews.each do |stored|
          entries = stored.entries.map do |persisted|
            entry = restored_restriction_entry(persisted)
            if persisted.fabric_index || invalid_access_restriction_entry?(entry)
              raise Matter::StorageError.new("Invalid persisted restriction review entry")
            end
            entry
          end
          if stored.token == 0 || stored.fabric_index == 0 ||
             stored.fabric_index > MAX_VALID_FABRIC_INDEX || pending.has_key?(stored.token)
            raise Matter::StorageError.new("Invalid persisted restriction review token or fabric")
          end
          pending[stored.token] = RestrictionReviewRequest.new(stored.fabric_index, stored.token, entries)
          deadlines[stored.token] = stored.deadline
        end
        @restriction_review_timers.each_value(&.close)
        @restriction_review_timers.clear
        @access_restrictions = restrictions
        @commissioning_arl = commissioning_arl
        @commissioning_arl_configured = state.commissioning_arl_configured?
        @pending_restriction_reviews = pending
        @pending_restriction_review_deadlines = deadlines
        @reviews_needing_replay = pending.keys
        @next_restriction_review_token = {state.next_restriction_review_token, pending.keys.max? || 0_u64}.max
        @data_version = state.data_version

        @acl = state.acl.compact_map do |entry|
          idx = entry.fabric_index
          unless idx
            Log.warn { "restore_state: skipping ACL entry without fabric_index" }
            next
          end

          targets = entry.targets.try do |tgts|
            tgts.map { |target| Target.new(cluster: target.cluster, endpoint: target.endpoint, device_type: target.device_type) }
          end

          AccessControlEntry.new(
            privilege: entry.privilege,
            auth_mode: entry.auth_mode,
            subjects: entry.subjects,
            targets: targets,
            fabric_index: idx
          )
        end

        @extension = state.extension.map { |entry| ExtensionEntry.new(entry.data, entry.fabric_index) }
        resume_restriction_reviews
      rescue ex : Matter::AccessControlRestoreError
        Log.error(exception: ex) { "AccessControl restore failed; refusing startup" }
        raise ex
      rescue ex
        Log.error(exception: ex) { "AccessControl restore failed; refusing startup" }
        raise Matter::AccessControlRestoreError.new("Could not restore Access Control state", ex)
      end

      def fail_closed_restore? : Bool
        true
      end

      private def restored_restriction_entry(stored : PersistedRestrictionEntry) : AccessRestrictionEntry
        AccessRestrictionEntry.new(stored.endpoint, stored.cluster,
          stored.restrictions.map { |restriction| AccessRestriction.new(restriction.type, restriction.id) })
      end

      # Check if a subject has the required privilege
      # Supports CaseAuthenticatedTag (CAT) subject matching per Matter spec
      def check_access(subject : UInt64, fabric_index : UInt8, privilege : AccessControlEntryPrivilege,
                       cluster : UInt32? = nil, endpoint : UInt16? = nil, device_type : UInt32? = nil,
                       auth_mode : AccessControlEntryAuthMode = AccessControlEntryAuthMode::CASE) : Bool
        # Find matching ACL entries for this fabric
        matching_entries = (@acl + @auxiliary_acl).select do |entry|
          subjects = entry.subjects
          entry.fabric_index == fabric_index &&
            entry.auth_mode == auth_mode &&
            (!subjects || subjects.empty? || subjects.any? { |acl_subject| subject_matches?(acl_subject, subject) })
        end

        # Check if any entry grants sufficient privilege
        matching_entries.any? do |entry|
          # Check privilege level (higher privilege includes lower)
          has_privilege = entry.privilege >= privilege

          # Check target matching
          has_target_access = if targets = entry.targets
                                # Per spec, an empty targets list is a wildcard (all targets).
                                targets.empty? || targets.any? do |target|
                                  (!target.cluster || target.cluster == cluster) &&
                                    (!target.endpoint || target.endpoint == endpoint) &&
                                    (!target.device_type || target.device_type == device_type)
                                end
                              else
                                true # nil targets means all targets
                              end

          has_privilege && has_target_access
        end
      end

      # Convenience wrapper for the generated cluster metadata privilege enum.
      def check_access(subject : UInt64, fabric_index : UInt8, privilege : InteractionModel::EntryPrivilege,
                       cluster : UInt32? = nil, endpoint : UInt16? = nil, device_type : UInt32? = nil,
                       auth_mode : InteractionModel::EntryAuthMode = InteractionModel::EntryAuthMode::Case) : Bool
        check_access(
          subject: subject,
          fabric_index: fabric_index,
          privilege: AccessControlEntryPrivilege.from_value(privilege.value),
          cluster: cluster,
          endpoint: endpoint,
          device_type: device_type,
          auth_mode: AccessControlEntryAuthMode.from_value(auth_mode.value)
        )
      end

      # Check if a subject (from incoming request) matches an ACL subject
      # Supports CaseAuthenticatedTag (CAT) matching:
      # - For CAT subjects: identity must match, incoming version >= ACL version
      # - For regular NodeIds: exact match required
      private def subject_matches?(acl_subject : UInt64, incoming_subject : UInt64) : Bool
        acl_node = DataType::NodeId.new(acl_subject)
        incoming_node = DataType::NodeId.new(incoming_subject)

        # If both are CAT-encoded, use CAT matching rules
        if acl_node.case_authenticated_tag? && incoming_node.case_authenticated_tag?
          begin
            acl_cat = acl_node.extract_as_case_authenticated_tag
            incoming_cat = incoming_node.extract_as_case_authenticated_tag

            # CAT matching: identity must match, incoming version >= ACL version
            acl_cat.identity_value == incoming_cat.identity_value &&
              incoming_cat.version >= acl_cat.version
          rescue ex
            Log.trace(exception: ex) { "CAT extraction failed; falling back to exact subject match" }
            acl_subject == incoming_subject
          end
        else
          # Regular NodeId: exact match required
          acl_subject == incoming_subject
        end
      end

      # Helper: Get ACL entries for a specific fabric
      def get_acl_for_fabric(fabric_index : UInt8) : Array(AccessControlEntry)
        @acl.select { |entry| entry.fabric_index == fabric_index }
      end

      # Helper: Remove all ACL entries for a fabric
      def remove_fabric_acl(fabric_index : UInt8) : Nil
        @acl.reject! { |entry| entry.fabric_index == fabric_index }
        @auxiliary_acl.reject! { |entry| entry.fabric_index == fabric_index }
        @access_restrictions.delete(fabric_index)
        increment_version_and_notify(ATTR_ARL) if @feature_map.managed_device?
        @pending_restriction_reviews.each do |token, request|
          if request.fabric_index == fabric_index
            @restriction_review_timers.delete(token).try(&.close)
            @pending_restriction_review_deadlines.delete(token)
            @reviews_needing_replay.delete(token)
          end
        end
        @pending_restriction_reviews.reject! { |_, request| request.fabric_index == fabric_index }
        increment_version_and_notify(ATTR_ACL)
        notify_changed(ATTR_AUXILIARY_ACL) if @feature_map.auxiliary?
      end

      # Replaces the accessing fabric's ACL entries (all entries outside a fabric).
      def acl=(entries : Array(AccessControlEntry)) : Nil
        if entries.any? { |entry| !entry.auxiliary_type.nil? }
          raise Matter::ClusterError.new("Primary ACL entries cannot carry AuxiliaryType", InteractionModel::StatusCode::Failure)
        end
        fabric_index = request_fabric_index
        exceeds_fabric_limit = if fabric_index
                                 entries.size > access_control_entries_per_fabric
                               else
                                 entries.group_by(&.fabric_index).values.any? { |fabric_entries| fabric_entries.size > access_control_entries_per_fabric }
                               end
        if exceeds_fabric_limit || entries.any? do |entry|
             (entry.subjects.try(&.size) || 0) > subjects_per_access_control_entry ||
             (entry.targets.try(&.size) || 0) > targets_per_access_control_entry
           end
          raise Matter::ClusterError.new("ACL entry exceeds the advertised limit", InteractionModel::StatusCode::ConstraintError)
        end
        entries.map! do |entry|
          entry.fabric_index = fabric_index if fabric_index
          entry
        end
        if fabric_index
          @acl.reject! { |entry| entry.fabric_index == fabric_index }
          @acl.concat(entries)
        else
          @acl = entries
        end
        increment_version_and_notify(ATTR_ACL)
      end

      # Replaces the accessing fabric's Extension entries (all entries outside a fabric).
      def extension=(entries : Array(ExtensionEntry)) : Nil
        fabric_index = request_fabric_index
        if entries.any? { |entry| entry.data.size > 128 || !valid_extension_data?(entry.data) }
          raise Matter::ClusterError.new("Invalid Access Control Extension data", InteractionModel::StatusCode::ConstraintError)
        end
        if fabric_index
          if entries.size > 1
            raise Matter::ClusterError.new("Only one Extension entry is allowed per fabric", InteractionModel::StatusCode::ConstraintError)
          end
          entries.map! do |entry|
            entry.fabric_index = fabric_index
            entry
          end
          @extension.reject! { |entry| entry.fabric_index == fabric_index }
          @extension.concat(entries)
        else
          if entries.any? { |entry| entry.fabric_index.nil? } || entries.group_by(&.fabric_index).any? { |_index, items| items.size > 1 }
            raise Matter::ClusterError.new("Extension entry needs one FabricIndex per fabric", InteractionModel::StatusCode::ConstraintError)
          end
          @extension = entries
        end
        increment_version_and_notify(ATTR_EXTENSION)
      end

      private def valid_extension_data?(data : Bytes) : Bool
        io = IO::Memory.new(data)
        value = TLV::Any.from_io(io)
        return false unless io.pos == data.size && value.header.anonymous? && value.header.element_type.list?
        value.as_list.all? do |item|
          type = item.header.tag_type
          type.common_profile? || type.vendor_profile?
        end
      rescue
        false
      end

      # The SDK reports per-entry changes for administrator writes, but does
      # not report internal startup restore or fabric cleanup as admin edits.
      private def emit_acl_changes(previous : Array(AccessControlEntry), current : Array(AccessControlEntry), fabric_index : UInt8) : Nil
        admin_node_id, admin_passcode_id = change_administrator
        return if admin_node_id.nil? && admin_passcode_id.nil?

        {previous.size, current.size}.max.times do |index|
          old_entry = previous[index]?
          new_entry = current[index]?
          next if old_entry && new_entry && old_entry.to_slice == new_entry.to_slice

          change_type = if !old_entry
                          ChangeType::Added
                        elsif !new_entry
                          ChangeType::Removed
                        else
                          ChangeType::Changed
                        end
          emit_event(EVENT_ACCESS_CONTROL_ENTRY_CHANGED,
            EntryChangedEvent.new(admin_node_id, admin_passcode_id, change_type, new_entry), fabric_index)
        end
      end

      private def emit_extension_changes(previous : Array(ExtensionEntry), current : Array(ExtensionEntry), fabric_index : UInt8) : Nil
        admin_node_id, admin_passcode_id = change_administrator
        return if admin_node_id.nil? && admin_passcode_id.nil?

        {previous.size, current.size}.max.times do |index|
          old_entry = previous[index]?
          new_entry = current[index]?
          next if old_entry && new_entry && old_entry.to_slice == new_entry.to_slice

          change_type = if !old_entry
                          ChangeType::Added
                        elsif !new_entry
                          ChangeType::Removed
                        else
                          ChangeType::Changed
                        end
          emit_event(EVENT_ACCESS_CONTROL_EXTENSION_CHANGED,
            ExtensionChangedEvent.new(admin_node_id, admin_passcode_id, change_type, new_entry), fabric_index)
        end
      end

      private def change_administrator : Tuple(UInt64?, UInt16?)
        if request_is_case_session?
          {@request_peer_node_id, nil}
        else
          {nil, nil}
        end
      end
    end
  end
end
