require "../spec_helper"

# Real operational certificate chains, from the vectors matter.js tests against
# (`packages/protocol/test/certificate/TestCertificates.ts`). Each was issued by
# a shipping implementation, so a chain that verifies here verifies the
# signatures those implementations actually produce.
CERTIFICATE_CHAINS = [
  {
    name: "General Test Certificates",
    root: "",
    icac: nil,
    noc:  "",
  },
  {
    name: "Matter 1.2 Specification Certificates",
    root: "",
    icac: "",
    noc:  "",
  },
  {
    name: "Apple Certificates",
    root: "",
    icac: nil,
    noc:  "",
  },
  {
    name: "Google Certificates",
    root: "",
    icac: "",
    noc:  "",
  },
  {
    name: "Amazon Certificates",
    root: "",
    icac: "",
    noc:  "",
  },
  {
    name: "SmartThings Certificates",
    root: "",
    icac: "",
    noc:  "",
  },
  {
    name: "Aqara Certificates",
    root: "",
    icac: "",
    noc:  "",
  },
]

private def root_public_key(chain) : Bytes
  Matter::Crypto::MatterCertificate.public_key_from_tlv(chain[:root].hexbytes)
end

describe Matter::Crypto::MatterCertificate::Validation do
  CERTIFICATE_CHAINS.each do |chain|
    it "accepts the #{chain[:name]} chain" do
      noc = chain[:noc].hexbytes
      icac = chain[:icac].try(&.hexbytes)
      starts = [Matter::Crypto::MatterCertificate.from_slice(noc).not_before]
      starts << Matter::Crypto::MatterCertificate.from_slice(icac).not_before if icac
      # Some published interoperability vectors are expired now; exercise
      # their chain profile and signature at a time within their lifetime.
      Timecop.travel(Time.unix(Matter::Crypto::MatterCertificate::Asn1::MATTER_EPOCH_OFFSET + starts.max + 1)) do
        Matter::Crypto::MatterCertificate::Validation.verify_chain(noc, icac, root_public_key(chain), chain[:root].hexbytes)
      end
    end
  end

  it "rejects a node certificate signed by nobody in the chain" do
    chain = CERTIFICATE_CHAINS.find! { |candidate| candidate[:name] == "Amazon Certificates" }
    other = CERTIFICATE_CHAINS.find! { |candidate| candidate[:name] == "Google Certificates" }

    expect_raises(Matter::AuthenticationError) do
      Matter::Crypto::MatterCertificate::Validation.verify_chain(
        chain[:noc].hexbytes,
        chain[:icac].try(&.hexbytes),
        root_public_key(other)
      )
    end
  end

  it "rejects a node certificate whose contents were edited after signing" do
    chain = CERTIFICATE_CHAINS.find! { |candidate| candidate[:name] == "Apple Certificates" }
    certificate = chain[:noc].hexbytes

    # Swap a byte of the subject public key, which the signature covers. A peer
    # doing this would be claiming the certificate's identity for its own key.
    public_key = Matter::Crypto::MatterCertificate.public_key_from_tlv(certificate)
    offset = (0..certificate.size - public_key.size).find! do |index|
      certificate[index, public_key.size] == public_key
    end

    forged = certificate.dup
    forged[offset + public_key.size - 1] ^= 0xFF_u8

    expect_raises(Matter::AuthenticationError) do
      Matter::Crypto::MatterCertificate::Validation.verify_chain(
        forged,
        chain[:icac].try(&.hexbytes),
        root_public_key(chain)
      )
    end
  end

  it "rejects an intermediate certificate that is not a certificate authority" do
    chain = CERTIFICATE_CHAINS.find! { |candidate| candidate[:name] == "Amazon Certificates" }

    expect_raises(Matter::AuthenticationError, /cannot sign certificates/) do
      Matter::Crypto::MatterCertificate::Validation.verify_chain(
        chain[:noc].hexbytes,
        chain[:noc].hexbytes,
        root_public_key(chain)
      )
    end
  end
end
